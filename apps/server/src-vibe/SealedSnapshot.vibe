import { Data, Effect } from "effect"
import { encodeStoredImpl } from "./stored-encoder.ts"

export class SnapshotFailure extends Data.TaggedError("SnapshotFailure")<{ readonly code: string }> {}
const failed = (code: string) => new SnapshotFailure({ code })
const utf8 = new TextEncoder()
export const base64 = (value: Uint8Array): string => {
  let encoded = ""
  for (let start = 0; start < value.length; start += 16_384) encoded += String.fromCharCode(...value.subarray(start, start + 16_384))
  return btoa(encoded)
}

/** Explicit types preserve structured storage values without ambiguous tags in user objects. */
export const encodeStored: (value: unknown, seen?: Set<object>) => unknown = encodeStoredImpl

export interface SnapshotProvenance {
  readonly keyVersion: "model-vault:v1" | null
  readonly migrationId: string
  readonly binding: string
  readonly objectId: string
  readonly sourceRevision: string
  readonly sourceVersion: string
  readonly capturedAt: string
}
export interface SnapshotMetadata extends SnapshotProvenance {
  readonly version: 1
  readonly schema: "smithers-do-storage/v1"
}
export interface PageMetadata extends SnapshotProvenance {
  readonly version: 2
  readonly schema: "smithers-do-storage-page/v2"
  readonly page: {
    readonly scanId: string
    readonly index: number
    readonly previousSHA256: string | null
    readonly entriesBefore: number
    readonly entriesThrough: number
    readonly complete: boolean
    /** No writer is fenced: a multi-page scan is never an atomic snapshot. */
    readonly consistency: "unfenced"
  }
}
export interface SealedEnvelope<M = SnapshotMetadata> {
  readonly metadata: M
  readonly algorithm: "RSA-OAEP-256+A256GCM"
  readonly wrappedKey: string
  readonly nonce: string
  readonly ciphertext: string
}
export type SealedSnapshot = SealedEnvelope<SnapshotMetadata>
export type SealedPage = SealedEnvelope<PageMetadata>
export interface PageResponse { readonly snapshot: SealedPage; readonly cursor: string | null }
export const PAGE_ENTRIES = 256
export const PAGE_BYTES = 1_000_000
export const PAGE_RESPONSE_BYTES = 1_500_000
export const CURSOR_BYTES = 16_384

/** Storage orders keys by UTF-8 bytes, not JavaScript UTF-16 code units. */
export const compareStorageKeys = (a: string, b: string): number => {
  const x = utf8.encode(a), y = utf8.encode(b)
  for (let i = 0; i < Math.min(x.length, y.length); i++) if (x[i] !== y[i]) return x[i]! - y[i]!
  return x.length - y.length
}
export const snapshotDigest = (value: string) => ((try(async (utf8, value) => crypto.subtle.digest("SHA-256", utf8.encode(value)), () => failed("snapshot_digest_failed"), utf8, value)) |> Effect.map(%, value => [...new Uint8Array(value)].map(byte => byte.toString(16).padStart(2, "0")).join("")))

/** Stateless, encrypted continuation; source/provenance is authenticated as AAD. */
export const snapshotCursor = (token: string, aad: string, value: { mutable seal: string } | { mutable open: string }) => {
  const material = try(async (utf8, token) => crypto.subtle.digest("SHA-256", utf8.encode("smithers-do-page-cursor/v2\0" + token)), () => failed("invalid_export_cursor"), utf8, token)
  const key = try(async (material) => crypto.subtle.importKey("raw", material, "AES-GCM", false, ["encrypt", "decrypt"]), () => failed("invalid_export_cursor"), material)
  if ("seal" in value) {
    const iv = sync(() => crypto.getRandomValues(new Uint8Array(12)))
    const ciphertext = try(async (utf8, value, aad, key, iv) => crypto.subtle.encrypt({ name: "AES-GCM", iv, additionalData: utf8.encode(aad) }, key, utf8.encode(value.seal)), () => failed("invalid_export_cursor"), utf8, value, aad, key, iv)
    const bytes = new Uint8Array(12 + ciphertext.byteLength)
    bytes.set(iv); bytes.set(new Uint8Array(ciphertext), 12)
    return base64(bytes)
  }
  const bytes = try((value) => Uint8Array.from(atob(value.open), ch => ch.charCodeAt(0)), () => failed("invalid_export_cursor"), value)
  const plaintext = try(async (utf8, aad, key, bytes) => crypto.subtle.decrypt({ name: "AES-GCM", iv: bytes.subarray(0, 12), additionalData: utf8.encode(aad) }, key, bytes.subarray(12)), () => failed("invalid_export_cursor"), utf8, aad, key, bytes)
  try { return new TextDecoder().decode(plaintext) } finally { new Uint8Array(plaintext).fill(0) }
}

/** The owning isolate exports ciphertext only; the recipient private key never reaches it. */
export const sealSnapshot = <M extends SnapshotMetadata | PageMetadata>(metadata: M, values: unknown, recipient: JsonWebKey): Effect.Effect<SealedEnvelope<M>, SnapshotFailure, never> =>
  (() => {
    if (recipient.kty !== "RSA" || ["d", "p", "q", "dp", "dq", "qi", "oth"].some(name => name in recipient) ||
      !recipient.n || !recipient.e || recipient.n.length < 342) return (throw failed("invalid_export_recipient"))
    const plaintext = try((utf8, values) => utf8.encode(JSON.stringify(values)), () => failed("unserializable_snapshot"), utf8, values)
    return (((() => {
    if (plaintext.byteLength > (metadata.version === 2 ? PAGE_BYTES : 8_000_000)) return (throw failed("snapshot_requires_paged_export"))
    const publicKey = try(async (recipient) => crypto.subtle.importKey("jwk", recipient, { name: "RSA-OAEP", hash: "SHA-256" }, false, ["wrapKey"]), () => failed("invalid_export_recipient"), recipient)
    const key = try(async () => crypto.subtle.generateKey({ name: "AES-GCM", length: 256 }, true, ["encrypt"]), () => failed("snapshot_encryption_failed"))
    const nonce = sync(() => crypto.getRandomValues(new Uint8Array(12)))
    const ciphertext = try(async (utf8, key, metadata, plaintext, nonce) => crypto.subtle.encrypt({ name: "AES-GCM", iv: nonce, additionalData: utf8.encode(JSON.stringify(metadata)) }, key, plaintext), () => failed("snapshot_encryption_failed"), utf8, key, metadata, plaintext, nonce)
    const wrapped = try(async (key, publicKey) => crypto.subtle.wrapKey("raw", key, publicKey, { name: "RSA-OAEP" }), () => failed("snapshot_encryption_failed"), key, publicKey)
    return { metadata, algorithm: "RSA-OAEP-256+A256GCM" as const, wrappedKey: base64(new Uint8Array(wrapped)), nonce: base64(nonce), ciphertext: base64(new Uint8Array(ciphertext)) }
    })()) |> Effect.ensuring(%, sync((plaintext) => plaintext.fill(0), plaintext)))
  })()

/** Fixed-size digest comparison; neither secret nor request material is logged. */
export const authenticatedExport = (authorization: string | null, configured: string | undefined): Effect.Effect<boolean, never, never> =>
  (() => {
    if (!configured || configured.length < 43 || !authorization?.startsWith("Bearer ")) return false
    const supplied = authorization.slice(7)
    if (supplied.length > 200) return false
    const hashes = ((try(async (utf8, configured, supplied) => Promise.all([
      crypto.subtle.digest("SHA-256", utf8.encode(configured)), crypto.subtle.digest("SHA-256", utf8.encode(supplied))
    ]), () => failed("authentication_failed"), utf8, configured, supplied)) |> Effect.catch(%, () => Effect.succeed(undefined)))
    if (hashes === undefined) return false
    const a = new Uint8Array(hashes[0]!), b = new Uint8Array(hashes[1]!)
    let different = 0
    for (let i = 0; i < a.length; i++) different |= a[i]! ^ b[i]!
    return different === 0
  })()
