---
import Base from "../layouts/Base.astro"
import { WORDMARK } from "@smthrs/ui"
import { landingCopy } from "../data/landingCopy"

const runners = Object.entries(landingCopy.commands)
const firstCommand = landingCopy.commands.npx
const noteParts = landingCopy.runNote.split(/(`[^`]+`)/)
---
<Base title={landingCopy.title} description={landingCopy.tagline} header={false} footer={false}>
  <div id="landing">
    <main class="landing-main">
      <pre class="landing-wordmark" aria-label="Smithers">{WORDMARK.join("\n")}</pre>
      <h1>{landingCopy.headline}</h1>
      <p class="landing-sub">{landingCopy.tagline}</p>
      <section class="landing-run" aria-labelledby="landing-run-label">
        <div class="landing-run-head">
          <h2 id="landing-run-label">{landingCopy.runLabel}</h2>
          <div class="landing-runner" role="radiogroup" aria-label={landingCopy.runnerLabel} hidden>
            {runners.map(([runner, command], index) => <label><input type="radio" name="runner" value={runner} data-command={command} checked={index === 0} autocomplete="off" />{runner}</label>)}
          </div>
        </div>
        <div class="landing-command"><code><span aria-hidden="true">$ </span><span id="run-command">{firstCommand}</span></code><button type="button" id="copy-install" data-command={firstCommand}><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/><path d="M10.5 5.5v-2A1.5 1.5 0 0 0 9 2H4A1.5 1.5 0 0 0 2.5 3.5v5A1.5 1.5 0 0 0 4 10h1.5"/></svg><span>Copy</span></button></div>
        <p class="landing-note">{noteParts.map(part => part.startsWith("`") ? <code>{part.slice(1, -1)}</code> : part)}</p>
      </section>
      <nav class="landing-actions" aria-label="Start">
        <a class="landing-button" href={landingCopy.docs.href}>{landingCopy.docs.label}</a>
        <a class="landing-button" href={landingCopy.source.href}>{landingCopy.source.label}</a>
      </nav>
    </main>
  </div>
</Base>
<script>
  const copy = document.getElementById("copy-install")
  const command = document.getElementById("run-command")
  const runner = document.querySelector<HTMLElement>(".landing-runner")
  // Progressive enhancement: without this script the page shows the npx command.
  if (copy && command && runner) {
    const choose = (input: HTMLInputElement) => {
      command.textContent = input.dataset.command!
      copy.dataset.command = input.dataset.command!
    }
    runner.addEventListener("change", event => choose(event.target as HTMLInputElement))
    const checked = runner.querySelector<HTMLInputElement>("input:checked")
    if (checked) choose(checked)
    runner.hidden = false
  }
  copy?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.command!)
      copy.querySelector("span")!.textContent = "Copied"
      setTimeout(() => { copy.querySelector("span")!.textContent = "Copy" }, 2000)
    } catch { copy.querySelector("span")!.textContent = "Try again" }
  })
</script>
<style is:global>
  #landing { --bg:#f7f4ee; --text:#211d18; --text-muted:#665f54; --surface:#fffefa; --border:rgb(33 29 24 / 8%); --border-strong:rgb(33 29 24 / 14%); --brand:#0f766e; --on-brand:#fffefa; min-height:100svh; color:var(--text); background:var(--bg); }
  @media(prefers-color-scheme:dark) { #landing { --bg:#0d1514; --text:#ece7db; --text-muted:#a9a598; --surface:#15201e; --border:rgb(236 231 219 / 10%); --border-strong:rgb(236 231 219 / 18%); --brand:#45c4b2; --on-brand:#0d1514; } }
  .landing-main { width:100%; max-width:720px; box-sizing:border-box; margin:0 auto; padding:96px 16px 64px; }
  .landing-wordmark { font:min(13.5px, 2.1vw)/1.15 var(--font-mono); color:var(--brand); margin:0 0 24px; overflow:visible; }
  .landing-main h1 { font-size:44px; font-weight:600; letter-spacing:-.02em; line-height:1.1; margin:0 0 12px; }
  .landing-sub { font-size:19px; line-height:1.5; color:var(--text-muted); max-width:620px; margin:0 0 40px; }
  .landing-run { max-width:620px; }
  .landing-run-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:0 0 8px; }
  .landing-run-head h2 { font-size:14px; font-weight:500; margin:0; }
  .landing-runner { display:flex; gap:2px; padding:2px; border:1px solid var(--border-strong); border-radius:8px; background:var(--surface); }
  .landing-runner[hidden] { display:none; }
  .landing-runner label { position:relative; padding:3px 10px; border-radius:6px; font:13px var(--font-mono); color:var(--text-muted); cursor:pointer; }
  .landing-runner input { position:absolute; inset:0; margin:0; opacity:0; cursor:pointer; }
  .landing-runner label:has(input:checked) { background:var(--bg); color:var(--text); box-shadow:inset 0 0 0 1px var(--border-strong); }
  .landing-runner label:has(input:focus-visible) { outline:2px solid var(--text); outline-offset:2px; }
  .landing-command { display:flex; align-items:center; gap:10px; width:100%; box-sizing:border-box; min-height:44px; padding:6px 6px 6px 14px; border:1px solid var(--border-strong); border-radius:8px; background:var(--surface); }
  .landing-command code { flex:1; min-width:0; font:14px/1.5 var(--font-mono); white-space:nowrap; overflow-x:auto; }
  .landing-command code span[aria-hidden] { color:var(--text-muted); }
  .landing-command button { height:32px; padding:0 12px; border:0; border-radius:6px; background:var(--brand); color:var(--on-brand); font:500 14px var(--font-ui); cursor:pointer; }
  .landing-command button { display:flex; align-items:center; gap:6px; flex:none; border:1px solid var(--border-strong); background:var(--bg); color:var(--text); }
  .landing-command button:hover { border-color:var(--text-muted); }
  .landing-note { margin:8px 0 0; font-size:13px; line-height:1.5; color:var(--text-muted); }
  .landing-note code { font-size:.95em; }
  .landing-actions { display:flex; flex-wrap:wrap; gap:8px; margin:32px 0 0; }
  .landing-button { display:flex; align-items:center; height:40px; padding:0 16px; border:1px solid var(--border-strong); border-radius:8px; background:var(--surface); color:inherit; font:500 14px var(--font-ui); text-decoration:none; }
  .landing-button:hover { border-color:var(--text-muted); }
  #landing :focus-visible { outline:2px solid currentColor; outline-offset:4px; }
  @media(max-width:600px) { .landing-main { padding-top:40px; } .landing-main h1 { font-size:30px; } .landing-sub { font-size:17px; margin-bottom:32px; } .landing-command code { white-space:normal; font-size:13px; } }
</style>
