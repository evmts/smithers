              "source": "// Drafted by Smithers from a prompt. In this form it runs on your device; other code needs a sandbox.\nimport { AgentAction } from \"@smthrs/agent\"\nimport { Flow } from \"@smthrs/flow\"\nimport { Schema } from \"effect\"\n\n/** What the agent does each time the flow runs. */\nconst instructions = [\n  \"Open the Effect documentation page for the person.\",\n  \"\",\n  \"1. Call app/web/open with to \\\"https://effect.website/docs\\\" and mode \\\"embed\\\" (embed is the default). This is the one call that does the job; do not pick a different URL for these docs.\",\n  \"\",\n  \"2. The answer is { viewId, origin, mode, shown, framing, title? }. Branch on shown:\",\n  \"   - If shown is \\\"page\\\", the page is embedded in the chat with its origin shown above it. Say you opened the Effect documentation in the chat and name the origin it reported (the title too when it came back).\",\n  \"   - If shown is \\\"card\\\" (framing \\\"refused\\\" or \\\"unknown\\\"), embedding was not possible: the card with an Open in new tab button has already been added to the chat. Say plainly that you added a card that opens the Effect documentation in a new tab. Never describe the page as shown in the chat.\",\n  \"\",\n  \"3. If the call fails or its tab has closed, report the error's message plainly; do not retry more than once.\",\n  \"\",\n  \"Never invent the page's title, origin, or a framing result that the call did not return.\",\n].join(\"\\n\")\n\n/** The flow's one step: the agent follows the instructions with the run's input. */\nconst Agent = AgentAction.make(\"open-effect-docs/agent\", {\n  payload: { input: Schema.String },\n  output: Schema.String,\n  seat: \"agent\",\n  prompt: ({ input }) => (input === \"\" ? instructions : `${instructions}\\n\\nInput: ${input}`),\n})\n\nexport default Flow.make(\"open-effect-docs\", {\n  description: \"Open the Effect documentation page at https://effect.website/docs embedded in the chat with its origin shown, and fall back to a card that opens it in a new tab when the site refuses embedding.\",\n  capabilities: [],\n  flows: [\"app/web/open\"],\n  payload: { input: Schema.String },\n  success: Schema.String,\n  error: Agent.errorSchema,\n  body: ({ input }) => Agent.call({ input }),\n})\n"
