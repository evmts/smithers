        {
          "type": "hero",
          "title": "VibeLang",
          "tagline": "Reliable TypeScript for the AI era, built on Effect.",
          "text": "A simple, readable syntax for Effect that compiles to TypeScript, with first-class access to the TypeScript ecosystem.",
          "install": "npm create vibelang@latest my-app",
          "actions": [
            {
              "label": "Get started",
              "url": "https://vibelang.sh/getting-started/004-installation"
            },
            {
              "label": "Cheat sheet",
              "url": "https://vibelang.sh/vibelang-features/115-cheat-sheet"
            },
            {
              "label": "Docs",
              "url": "https://vibelang.sh"
            }
          ],
          "announcement": {
            "label": "v0: the language will change",
            "url": "https://vibelang.sh"
          }
        },
        {
          "type": "code",
          "file": "main.vibe",
          "language": "vibe",
          "code": "error NotFound { id: string }\n\nservice Users {\n  find(id: string): User!NotFound\n}\n\nfunction greet(id: string) {\n  return `Welcome, ${Users.find(id).name}`\n    catch (e) => `No user ${e.id}`\n}\n\nexport function main() {\n  provide UsersLive {\n    const [ada, missing] = await.all [greet(\"42\"), greet(\"7\")]\n    Console.log(ada, missing)\n  }\n}"
        },
        {
          "type": "stats",
          "stats": [
            {
              "value": "MIT",
              "label": "License"
            },
            {
              "value": "Effect 4",
              "label": "Runtime"
            },
            {
              "value": "macOS · Linux · Windows",
              "label": "arm64 and x64"
            },
            {
              "value": "v0",
              "label": "Breaking changes ahead"
            }
          ]
        },
        {
          "type": "cards",
          "title": "Why VibeLang",
          "cards": [
            {
              "title": "Every function is an Effect",
              "text": "A call runs where it stands: no generators, no yield*."
            },
            {
              "title": "Typed errors",
              "text": "error NotFound { id } and User!NotFound in the signature."
            },
            {
              "title": "Services and layers",
              "text": "service, provide and Layer as language."
            },
            {
              "title": "Concurrency",
              "text": "await.all, await.race, fork and join."
            },
            {
              "title": "Your editor knows it",
              "text": "Diagnostics, hovers and completions from the compiler."
            },
            {
              "title": "TypeScript interop",
              "text": "Checks .vibe and .ts together; emits JavaScript and types."
            }
          ]
        },
        {
