{
  "name": "smithers-mvp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The Worker answers /api/*; every other path is the single-page app.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
