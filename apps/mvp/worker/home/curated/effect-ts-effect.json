              { "name": "@effect/sql-pg@0.53.1", "url": "https://github.com/Effect-TS/effect/releases/tag/%40effect%2Fsql-pg%400.53.1", "date": "2026-10-16", "summary": "Closes the pool when the first connection check fails." },
              { "name": "effect@4.0.5", "url": "https://github.com/Effect-TS/effect/releases/tag/effect%404.0.5", "date": "2026-10-15", "summary": "A patch release of the 4.0 line." }
            ],
            "more": { "label": "All releases", "url": "https://github.com/Effect-TS/effect/releases" }
          },
