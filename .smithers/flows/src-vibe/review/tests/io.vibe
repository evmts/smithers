/** Real platform for helper integration tests; production helpers have no native fallback. */
import * as NodeChildProcessSpawner from "@effect/platform-node/NodeChildProcessSpawner"
import * as NodeFileSystem from "@effect/platform-node/NodeFileSystem"
import * as NodePath from "@effect/platform-node/NodePath"
import { Effect, FileSystem, Layer } from "effect"
import * as ChildProcessSpawner from "effect/process/ChildProcessSpawner"
import { withIo } from "../src/io.vibe"
// A-2/E-4 (D38): the async runner boundary stays TypeScript (src/io.native.ts).
import { runAsync } from "../src/io.native.ts"
export const testIo = <A>(operation: () => Promise<A>): Promise<A> =>
  runAsync(() => {
    provide NodeChildProcessSpawner.layer.pipe(Layer.provideMerge(Layer.merge(NodeFileSystem.layer, NodePath.layer))) {
      return Effect.scoped(() => {
        const fs = FileSystem.FileSystem()
        const spawner = ChildProcessSpawner.ChildProcessSpawner()
        return Effect.tryPromise({
          try: (signal) => withIo({ fs, spawner, signal }, operation),
          catch: (error) => error
        })
      })
    }
  })
