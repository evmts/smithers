import * as NodeServices from "@effect/platform-node/NodeServices"
import { DurableEngineState, EngineStore, StepBoundary } from "@smthrs/engine-store"
import { Action, Flow, FlowRuntime, Interpreter } from "@smthrs/flow"
import { Jj } from "@smthrs/kernel"
import { AttemptStore, RunStore } from "@smthrs/run-store"
import { RemoteChildProcessSpawner, type Sandbox } from "@smthrs/sandbox"
import { Effect, Layer, Option, Stream } from "effect"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { access, appendFile, readFile, rm, writeFile } from "node:fs/promises"
import { DurableWriter } from "../../../../../packages/smithers/flows/database/src/index.ts"
import * as NodeDatabase from "../../../../../packages/smithers/flows/database/src/node/NodeDatabase.ts"
import * as Migrations from "../../../../../packages/smithers/flows/engine-store/src/Migrations.ts"
import * as OwnerIdentity from "../../../../../packages/smithers/flows/engine-store/src/OwnerIdentity.ts"
import { withCrypto } from "../../../../../packages/smithers/flows/engine-store/test/Sha256.ts"
import { SqlJournal } from "../../../../../packages/smithers/flows/journal/src/index.ts"
import { CacheStore } from "../../../../../packages/smithers/flows/step-cache/src/index.ts"
import * as Native from "../../native.ts"
import { makeRemoteJob, RemoteFix } from "../work/flow.vibe"
import { argv, emit, run } from "./remote-job-host.native.ts"

const directory = argv[2]!
const mode = argv[3]!
const input = {
  repo: "smithersai/smithers",
  issue: 3378,
  text: { title: "Restart", body: "Fix", comments: [] },
  placement: "cloud" as const
}
const Caller = Flow.make("issue-sweep/test-retained-caller", {
  payload: {},
  success: RemoteFix.successSchema,
  error: RemoteFix.errorSchema,
  body: () => RemoteFix.call(input)
})
const log = (kind: string, key: string) =>
  sync(async (path: string, line: string) => appendFile(path, line), Native.join(directory, "calls"), `${kind}:${key}\n`)
const present = (name: string) =>
  sync(async (path: string) => access(path).then(() => true, () => false), Native.join(directory, name))
const machineFile = (key: string) => `machine-${encodeURIComponent(key)}`
const session = (key: string): Sandbox.Session => ({
  id: key,
  remoteId: `retained:${key}`,
  workdir: "/workspace",
  writeFile: () => {},
  readFile: (path) =>
    Effect.succeed(
      new TextEncoder().encode(
        path.endsWith("/key")
          ? key
          : path.endsWith("/out")
          ? "Fixed"
          : path.endsWith("/err")
          ? ""
          : path.endsWith("/exit")
          ? "0"
          : path.endsWith("/base")
          ? "abcdef"
          : "rotated-login"
      )
    ),
  spawn: (command) => {
    let stdout = ""
    if (command.includes("setsid /bin/sh")) {
      if (!present(`launched-${encodeURIComponent(key)}`)) {
        sync(
          async (path: string) => writeFile(path, "1"),
          Native.join(directory, `launched-${encodeURIComponent(key)}`)
        )
        log("launch", key)
      }
    } else if (command.startsWith("if test -f")) {
      log("status", key)
      stdout = present("exited") ? "Exited 0" : "Running"
    } else if (command.includes("kill -TERM")) {
      log("cancel", key)
    } else if (command.includes("smithers-capture.")) {
      log("capture", key)
      stdout = "diff --git a/a b/a\n--- a/a\n+++ b/a\n@@ -1 +1 @@\n-old\n+new\n"
    }
    return {
      stdout: Stream.make(new TextEncoder().encode(stdout)),
      stderr: Stream.empty,
      exitCode: Effect.succeed(0)
    }
  }
})
const provider: Sandbox.Provider = {
  retained: true,
  acquire: (key) => {
    sync(async (path: string) => writeFile(path, "retained"), Native.join(directory, machineFile(key)))
    return session(key)
  },
  attach: (handle) => {
    if (!present(machineFile(handle.id))) {
      throw new RemoteChildProcessSpawner.ProviderError({ code: "not_found", message: "machine lost" })
    }
    return session(handle.id)
  },
  destroy: (handle) => {
    log("destroy", handle.id)
    sync(async (path: string) => rm(path, { force: true }), Native.join(directory, machineFile(handle.id)))
  }
}
const ops = makeRemoteJob({
  provider: () => Effect.succeed(provider),
  reserve: () => Effect.succeed({ agent: "codex" as const, account: "account-1" }),
  restore: () => {},
  release: () => {},
  readLogin: () => Effect.succeed("borrowed-login"),
  saveLogin: (_account, login) =>
    sync(async (path: string, login: string) => writeFile(path, login), Native.join(directory, "saved-login"), login),
  cool: () => {}
})
const implementations = RemoteFix.toLayer({
  ...ops,
  start: (input, key) => {
    log("start", key)
    return ops.start(input, key)
  },
  collect: (handle, key, exited) => {
    log("collect", key)
    return ops.collect(handle, key, exited)
  }
})
const jj = Jj.make({
  snapshot: () => Effect.succeed({ commitId: "external-job-test" as never, changeId: "external-job-test" as never }),
  restore: () => {},
  diff: () => Effect.succeed(""),
  workspaceAdd: () => {},
  workspaceForget: () => {},
  status: () => Effect.succeed("")
})
const database = Layer.provideMerge(
  DurableWriter.layer(),
  NodeDatabase.layer({ filename: Native.join(directory, "state.sqlite") })
)
const sqlServices = Layer.provideMerge(
  Layer.mergeAll(
    AttemptStore.layer,
    CacheStore.layer,
    RunStore.layer,
    DurableEngineState.layer,
    SqlJournal.layer({ capacity: 64, overflow: "reject" })
  ),
  Layer.provideMerge(Migrations.layer, database)
)
const requirements = Layer.mergeAll(
  sqlServices,
  StepBoundary.layerTest(),
  OwnerIdentity.layer,
  Layer.succeed(Jj.Jj, jj)
)

function host() {
  return withCrypto(Effect.scoped(() => {
    provide NodeServices.layer {
      provide KeyValueStore.layerFileSystem(Native.join(directory, "receipts")) {
        provide requirements {
          const engine = EngineStore.make({
            owner: { hostId: `external-job-${mode}` },
            journalSource: "external-job-test",
            isAlive: () => Effect.succeed(false)
          })
          const layerScope = Effect.scope()
          const layers = Layer.mergeAll(implementations, Interpreter.layer(Caller))
          Effect.provideService(
            Layer.buildWithScope(layers.pipe(Layer.provideMerge(Action.layerImplementations)), layerScope),
            FlowRuntime.FlowRuntime,
            engine
          )
          if (mode === "start" || mode === "cancel") {
            engine.execute(Caller, { executionId: "external-job-root", payload: {}, discard: true })
          }
          const runs = RunStore.RunStore()
          // Allow startup/recovery scheduling overhead around the real 15s job probe.
          const settleDeadline = Date.now() + 60_000
          while (Date.now() < settleDeadline) {
            const row = runs.get("external-job-root")
            if (mode === "start" && row.status === "suspended") {
              emit({ status: "parked" })
              return Effect.never()
            }
            if (mode === "cancel" && row.status === "suspended") {
              engine.interrupt(Caller, "external-job-root")
              // The retained worker is destroyed after the run settles cancelled, so
              // the receipt waits for both before the test reads the calls.
              for (let attempt = 0; attempt < 1200; attempt++) {
                const calls = sync(async (path: string) => readFile(path, "utf8"), Native.join(directory, "calls"))
                const cancelled = runs.get("external-job-root")
                if (calls.includes("cancel:") && calls.includes("destroy:") && cancelled.status === "cancelled") {
                  emit({ status: "cancelled" })
                  return
                }
                sleep("25 millis")
              }
              return Effect.die("cancellation did not finish")
            }
            if (mode === "restart" && row.status === "completed") {
              const outcome = Option.getOrThrow(engine.poll(Caller, "external-job-root"))
              if (outcome._tag !== "Complete" || outcome.exit._tag !== "Success") {
                return Effect.die("missing completion result")
              }
              emit({ status: "completed", value: outcome.exit.value })
              return
            }
            if (row.status === "failed" || row.status === "cancelled") {
              return Effect.die(row.stateJson)
            }
            sleep("25 millis")
          }
          return Effect.die("external job did not settle")
        }
      }
    }
  }))
}

// A-2/E-4, E-7: the runner, the arguments and the output are in remote-job-host.native.ts.
run(host)
