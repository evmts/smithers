/** Executable boundary only: Node-compatible process APIs also run under Bun. */
import { NodeServices } from "@effect/platform-node"
import { Effect, FileSystem, Layer, Path, Schema } from "effect"
import { readFile, realpath } from "node:fs/promises"
import { sep } from "node:path"
import { containedWikiOutput } from "../coding/wiki-output.ts"
import * as Native from "../native.ts"
import * as Platform from "./main.native.ts"
import { operations } from "./operations.vibe"
import { type Input, PageSpec } from "./schema.vibe"

const { values } = Platform.parseArgs({
  options: {
    check: { type: "boolean" },
    root: { type: "string" },
    output: { type: "string" },
    verified: { type: "boolean" },
    model: { type: "string", default: "openai:gpt-6-sol" },
    run: { type: "string" },
    database: { type: "string" },
    help: { type: "boolean" },
    "reuse-run": { type: "string" }
  }
})

// The script's body. TypeScript awaits each Effect.runPromise in turn; here the steps are one
// program, each step still provided as the TypeScript provides it.
const script = () => {
  if (values.help) {
    Console.log(
      "node --experimental-strip-types .smithers/flows/wiki/main.ts [--verified] [--model provider:model] [--output path] [--database .flows/engine.db] [--run id] [--reuse-run terminal-run-id]\nDefault: a clearly unreviewed preview. --verified performs real AgentAction semantic review and fails if any section lacks support. Runtime host is selected from the actual Node/Bun executable."
    )
  } else {
    const root = sync(async (path: string) => realpath(path), Native.resolve(values.root ?? Platform.cwd()))
    const requestedOutput = Native.resolve(root, values.output ?? ".flows/wiki")
    // The one page catalog: the `pages` of the repository's coding project,
    // the same declaration the Cloud refresh (coding/wiki) publishes.
    const project = sync(
      async (file: string) => JSON.parse(await readFile(file, "utf8")) as { pages?: unknown },
      Native.resolve(root, ".smithers/coding-project.json")
    )
    const pages = Schema.decodeUnknownSync(Schema.Array(PageSpec).check(Schema.isMinLength(1), Schema.isMaxLength(30)))(
      project.pages
    )
    const sourceFiles = [...new Set(pages.flatMap((page) => [page.document, ...page.inputs]))]
    if (values.check) {
      const checked = Effect.provide(
        operations({ root, output: requestedOutput }).check(pages, values.verified),
        NodeServices.layer
      )
      Console.log(JSON.stringify(checked, null, 2))
    } else {
      // Lexical containment is not enough: a committed symlink at .flows or any
      // other ancestor would route snapshots outside --root. Publication and the
      // engine database are resolved through their real ancestors, and
      // publication re-resolves after the (slow) review before writing.
      const publicationRoot: Effect.Effect<string, Error, FileSystem.FileSystem | Path.Path> = () =>
        containedWikiOutput(root, requestedOutput)
      const requestedDatabase = Native.resolve(root, values.database ?? ".flows/engine.db")
      if (!requestedDatabase.startsWith(Native.resolve(root, ".flows") + sep)) {
        throw new Error("--database must be a file under --root/.flows")
      }
      const [output, database] = Effect.provide(
        Effect.all([publicationRoot, containedWikiOutput(root, requestedDatabase)]),
        NodeServices.layer
      )
      const [{ Action, Interpreter }, { Capability }, { default: Wiki }, { actionLayers, agentLayers, hostEvaluator }] =
        sync(async () =>
          Promise.all([
            import("@smthrs/flow"),
            import("@smthrs/flows"),
            import("./flow.vibe"),
            import("./runtime.vibe")
          ])
        )
      const incremental = values["reuse-run"] ? sync(async () => import("./reuse.vibe")) : undefined
      if (incremental && !values.verified) {
        throw new Error("--reuse-run requires --verified and the existing database containing that terminal run")
      }
      const runtime = sync(async () =>
        typeof (globalThis as { Bun?: unknown }).Bun === "undefined"
          ? import("@smthrs/flows/NodeRuntime")
          : import("@smthrs/flows/BunRuntime")
      )
      // Credentials stay in the existing seat resolver. The receipt distinguishes
      // its subscription route so a different provider route cannot reuse approval.
      const reviewer = values.model.startsWith("openai:") && Platform.env().SMITHERS_OPENAI_AUTH === "chatgpt"
        ? `openai-chatgpt:${values.model.slice("openai:".length)}` :
        values.model
      const input: Input = { pages, mode: values.verified ? "verified" : "preview", reviewer }
      // A preflight source capture validates the declared evidence before admission;
      // actions independently recapture and the write gate rechecks it after review.
      const evaluator = values.verified ? hostEvaluator(Platform.env()) : undefined
      const layers = Layer.mergeAll(
        actionLayers({ root, output, publicationRoot, verify: !!values.verified, evaluator }),
        Interpreter.layer(Wiki),
        ...(incremental ? [incremental.reuseLayers({ root, output, publicationRoot })] : []),
        ...(values.verified
          ? [
            agentLayers(
              sync(async () => import("../release-support/runtime.vibe")).liveSeats(values.model),
              900_000,
              evaluator
            )
          ]
          : [])
      )
        .pipe(Layer.provideMerge(Action.layerImplementations))
      Effect.provide(
        Effect.forEach(pages, (page) => operations({ root, output }).collect(page)),
        NodeServices.layer
      )
      // The verified-snapshot seal key lives beside the output (operations.ts).
      const sealKey = Native.resolve(output, "..", `.${Native.basename(output)}.seal-key`)
      const rule = (action: "fs:read" | "fs:write", resource: string) =>
        new Capability.Permission.Rule({
          effect: "allow",
          pattern: new Capability.Capability.CapabilityPattern({ action, resource })
        })
      const rules = [
        ...[
          // Exact entries (no glob) for root and the output parent admit only the
          // realPath/stat of those directories, never the files beneath them.
          ...new Set([
            root,
            ...pages.flatMap((page) =>
              page.sourceDirectory === undefined ? [] : [
                Native.resolve(root, page.sourceDirectory),
                `${Native.resolve(root, page.sourceDirectory)}/**`
              ]
            ),
            ...sourceFiles.map((file) => Native.resolve(root, file)),
            ...(incremental?.policySources.map((file) => Native.resolve(root, file)) ?? []),
            output,
            `${output}/**`,
            Native.resolve(output, ".."),
            sealKey
          ])
        ].map((resource) => rule("fs:read", resource)),
        ...[output, `${output}/**`, sealKey].map((resource) => rule("fs:write", resource))
      ]
      const runId = values.run ?? `wiki-${Platform.randomUUID()}`
      Console.log(
        JSON.stringify({
          runId,
          output,
          mode: input.mode,
          model: values.verified ? values.model : null,
          reviewer: values.verified ? reviewer : null
        })
      )
      const execute = () => {
        if (incremental) {
          return incremental.IncrementalWiki.execute({
            ...input,
            mode: "verified",
            priorRunId: values["reuse-run"]!
          }, { executionId: runId })
        }
        return Wiki.execute(input, { executionId: runId })
      }
      const host = runtime.layerHost({
        filename: database,
        workspaceRoot: root,
        owner: { hostId: `wiki-${Platform.pid()}` },
        signals: [],
        rules: [rules]
      }, layers)
      const result = Effect.scoped(() => Effect.provide(() => execute(), host))
      Console.log(JSON.stringify({ runId, result }, null, 2))
    }
  }
}

// A-2/E-4: the runner boundary is TypeScript; a failure stays an unhandled rejection, as the
// TypeScript's top-level await left it.
Platform.runScript(script)
