{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "inlineSources": false,
    "sourceMap": false,
    // `checks.test.ts` is a `bun:test` suite, so the checked
    // set needs Bun's globals as well as Node's.
    "types": ["bun-types", "node"]
  },
  "include": ["*.ts", "evals/*.ts"],
  "exclude": ["PACKAGE.ts"]
}
