{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // `examples/42-placed-deploy.ts` type-checks `@smthrs/targets` sources,
    // which use ES2024 string methods.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "rootDir": "../../..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "test/**/*", "examples/**/*"]
}
