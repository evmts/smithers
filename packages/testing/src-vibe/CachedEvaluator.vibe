const asEvaluatorError = (failure: Model.ModelFailure): Evaluator.EvaluatorError => {
  const error = failure as ModelError
  return new Evaluator.EvaluatorError({
    code: isCode(error.providerCode) ? error.providerCode : "unreachable",
    message: error.message,
    ...(error.httpStatus === undefined ? {} : { status: error.httpStatus }),
    ...(error.resetAtEpochMillis === undefined ? {} : { resetAtEpochMillis: error.resetAtEpochMillis })
  })
}

import {evaluationRequest as requestPlain, asModel as modelPlain} from "./evaluatorBoundary.vibe"
/**
 * An evaluator that answers from a fixture and records what the fixture is
 * missing.
 *
 * It is `CachedModel` for the `/model/Evaluator` seam, and it records into the
 * same fixture. An evaluation is stored as one model call: its request is the
 * evaluation model's id and one user message holding the canonical JSON of the
 * state and the questions; its events are one text part holding the answer.
 * So one fixture file, one store and one canonical digest serve a run's model
 * turns and its judgments alike, and the recorder's credential guard covers
 * both.
 *
 * Without a live evaluator it only replays: a miss dies with
 * `UnscriptedModelError` and never reaches the network.
 *
 * @since 1.0.0
 */

import * as CanonicalJson from "@smthrs/model/CanonicalJson"
import * as Evaluator from "@smthrs/model/Evaluator"
import * as Model from "@smthrs/model/Model"
import { ModelError } from "@smthrs/model/ModelError"
import * as ModelEvent from "@smthrs/model/ModelEvent"
import { ModelRequest, type TextPart } from "@smthrs/model/ModelRequest"
import { Effect, Layer, Schema, Stream } from "effect"
import * as CachedModel from "./CachedModel.vibe"
import type { FixtureStore } from "./FixtureStore.vibe"

/**
 * What a cached evaluator is built from.
 *
 * @category models
 * @since 1.0.0
 */
export interface Options {
  /** The evaluator a miss runs against. Omit it to replay only. */
  readonly live?: Evaluator.Evaluator | undefined
  /** The fixture the evaluator reads and records into. */
  readonly fixture: FixtureStore
  /** The evaluation model a recording is keyed under; `Evaluator.defaultModel` by default. */
  readonly modelId?: string | undefined
  /** Rewrites run-varying text out of the recorded request, as `CachedModel`'s does. */
  readonly normalize?: CachedModel.Options["normalize"]
}

/** What a recording stores of a response: the answer, never its timing. */
const Recorded = Schema.Struct({
  answers: Evaluator.RawAnswers,
  confidence: Schema.optional(Schema.Record(Schema.String, Schema.Number)),
  usage: Schema.optional(Schema.Struct({
    inputTokens: Schema.Number,
    outputTokens: Schema.Number,
    modelId: Schema.optional(Schema.String),
    costUsd: Schema.optional(Schema.Number)
  }))
})

const decodeRecorded = Schema.decodeUnknownSync(Schema.fromJsonString(Recorded))

const isCode = Schema.is(Evaluator.EvaluatorErrorCode)

const textId = "evaluation"

/** The evaluation's state and questions, as the user message a recording keys on. */
const evaluationRequest: (modelId: string, prompt: string) => ModelRequest = requestPlain

/** A live evaluator as the model a recorder wraps: it reads the evaluation back out of the user message. */
const asModel: (live: Evaluator.Evaluator) => Model.Model = modelPlain

/**
 * Builds an evaluator that replays a recorded evaluation and records a miss.
 *
 * A recorded failure replays as the same `EvaluatorError` code, status and
 * reset. A recording that does not decode as an evaluation is a broken
 * fixture, so it is a defect.
 *
 * @category constructors
 * @since 1.0.0
 */
export const make = (options: Options): Evaluator.Evaluator => {
  const model = CachedModel.make({
    fixture: options.fixture,
    normalize: options.normalize,
    ...(options.live === undefined ? {} : { live: asModel(options.live) })
  })
  const modelId = options.modelId ?? Evaluator.defaultModel
  return {
    evaluate: (request) =>
      {
        const prompt = try((request) => CanonicalJson.stringify({ state: request.state, questions: Evaluator.encodeQuestions(request.questions) }), () => new Evaluator.EvaluatorError({ code: "invalid_question", message: "The evaluation needs JSON evidence and valid questions." }), request)
        const events = (() => {
          try { return Stream.runCollect(model.stream(requestPlain(modelId, prompt))) }
          catch (error) { throw asEvaluatorError(error) }
        })()

        const text = ModelEvent.settledMessage(events).message.content
          .filter((part): part is TextPart => part.type === "text")
          .map((part) => part.text)
          .join("")
        const recorded = decodeRecorded(text)
        return {
          answers: recorded.answers,
          ...(recorded.confidence === undefined ? {} : { confidence: recorded.confidence }),
          ...(recorded.usage === undefined ? {} : { usage: recorded.usage }),
          latencyMs: 0
        }
      }
  }
}

/**
 * Provides {@link make} as the `/model/Evaluator` seam.
 *
 * @category layers
 * @since 1.0.0
 */
export const layer = (options: Options): Layer.Layer<Evaluator.Evaluator> =>
  Layer.succeed(Evaluator.Evaluator)(make(options))
