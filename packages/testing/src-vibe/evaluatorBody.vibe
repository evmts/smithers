import * as CanonicalJson from "@smthrs/model/CanonicalJson"
import * as Evaluator from "@smthrs/model/Evaluator"
import * as Model from "@smthrs/model/Model"
import { ModelError } from "@smthrs/model/ModelError"
import * as ModelEvent from "@smthrs/model/ModelEvent"
import { ModelRequest, type TextPart } from "@smthrs/model/ModelRequest"
import { Effect, Layer, Schema, Stream } from "effect"
import * as CachedModel from "./CachedModel.vibe"
import type { FixtureStore } from "./FixtureStore.vibe"
const textId = "evaluation"
export function liveStream(live: Evaluator.Evaluator, request: ModelRequest): Stream.Stream<ModelEvent.ModelEvent>!ModelError {
  const message = request.messages[0] as { readonly content: ReadonlyArray<{ readonly text: string }> }
  const evaluation = sync((text) => JSON.parse(text) as {readonly state: unknown; readonly questions: Readonly<Record<string, Evaluator.Question>>}, message.content[0]!.text)
  let response: Evaluator.Response
  try { response = live.evaluate(evaluation) } catch (error) {
    throw new ModelError({ code: "unknown", providerCode: error.code, message: error.message, httpStatus: error.status, resetAtEpochMillis: error.resetAtEpochMillis })
  }
  const recorded = {answers: response.answers, ...(response.confidence === undefined ? {} : {confidence: response.confidence}), ...(response.usage === undefined ? {} : {usage: response.usage})}
  const events: ReadonlyArray<ModelEvent.ModelEvent> = [ {type: "text-start", id: textId}, {type: "text-delta", id: textId, text: JSON.stringify(recorded)}, {type: "text-end", id: textId}, {type: "settle", stopReason: "stop"} ]
  return Stream.fromIterable(events)
}
