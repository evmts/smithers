/**
 * Thread and message operations of the SQL memory store.
 *
 * @since 0.1.0
 */

import * as Dialect from "@smthrs/database/Dialect"
import * as Clock from "effect/Clock"
import type * as Crypto from "effect/Crypto"
import * as Effect from "effect/Effect"
import type { DatabaseService } from "../Database.vibe"
import type { MemoryError } from "../MemoryError.vibe"
import type { CompactMessagesInput, Service } from "../MemoryStore.vibe"
import { canonicalJson } from "./Canonical.vibe"
import { resolveNamespace } from "./ResolveNamespace.vibe"
import {
  changed,
  decodeJson,
  decodeThread,
  encodeJson,
  error,
  type Fragment,
  type MessageRow,
  storeError,
  type ThreadRow,
  validateLimit,
  validateNonEmpty,
  validateTime
} from "./Store.vibe"

const THREAD_COLUMNS = "thread_id, namespace_kind, namespace_id, title, metadata_json, created_at_ms, updated_at_ms"
const MESSAGE_COLUMNS = "thread_id, id, role, text, at_ms"

const DELETE_MESSAGES_CHUNK_SIZE = 900

/**
 * Builds the thread and message operations.
 *
 * @category constructors
 * @since 0.1.0
 */
export const make = (database: DatabaseService, crypto: Crypto.Crypto): Pick<
  Service,
  | "createThread"
  | "getThread"
  | "listThreads"
  | "deleteThread"
  | "appendMessage"
  | "listMessages"
  | "countMessages"
  | "messageStats"
  | "listThreadIds"
  | "deleteMessages"
  | "compactMessages"
> => {
  const { sql } = database
  const threadColumns = sql.literal(THREAD_COLUMNS)
  const messageColumns = sql.literal(MESSAGE_COLUMNS)

  const getThread: Service["getThread"] = (input) => {
    validateNonEmpty(input.threadId, "threadId", ["threadId"])
    const rows = sql<ThreadRow>`SELECT ${threadColumns}
      FROM memory_threads WHERE thread_id = ${input.threadId} LIMIT 1`() catch (cause) =>
      throw storeError("could not read memory thread")(cause)
    return rows[0] === undefined ? undefined : decodeThread(rows[0])
  }

  const createThread: Service["createThread"] = (input) => {
    const { namespace } = resolveNamespace(input.namespace)
    const id = input.id ?? (crypto.randomUUIDv4() catch (cause) =>
      throw error("store", "could not generate memory thread id", cause))
    validateNonEmpty(id, "threadId", ["id"])
    const metadataJson = input.metadata === undefined
      ? null
      : canonicalJson(
        decodeJson(
          encodeJson(input.metadata, "thread metadata", ["metadata"]),
          "thread metadata"
        )
      )
    const now = Clock.currentTimeMillis()
    return database.write(() => {
      const inserted = sql`INSERT INTO memory_threads (${threadColumns}) VALUES (
          ${id}, ${namespace.kind}, ${namespace.id}, ${input.title ?? null}, ${metadataJson}, ${now}, ${now}
        ) ON CONFLICT (thread_id) DO NOTHING`.raw()
      const rows = sql<ThreadRow>`SELECT ${threadColumns}
        FROM memory_threads WHERE thread_id = ${id} LIMIT 1`()
      const existing = rows[0]
      if (existing === undefined) {
        throw error("store", "created memory thread could not be read back")
      }
      if (changed(inserted) === 0) {
        const existingMetadata = existing.metadata_json === null
          ? null
          : canonicalJson(decodeJson(existing.metadata_json, "thread metadata"))
        if (
          existing.namespace_kind !== namespace.kind || existing.namespace_id !== namespace.id ||
          existing.title !== (input.title ?? null) || existingMetadata !== metadataJson
        ) {
          throw error(
            "idempotency_conflict",
            `thread id "${id}" already exists with different creation data`,
            undefined,
            ["threadId"]
          )
        }
      }
      return decodeThread(existing)
    }) catch (cause) => throw storeError("could not create memory thread")(cause)
  }

  const listThreads: Service["listThreads"] = (input = {}) => {
    const namespace = input.namespace === undefined
      ? undefined
      : resolveNamespace(input.namespace).namespace
    const where = namespace === undefined
      ? sql.literal("")
      : sql`WHERE namespace_kind = ${namespace.kind} AND namespace_id = ${namespace.id}`
    const rows = sql<ThreadRow>`SELECT ${threadColumns}
      FROM memory_threads
      ${where}
      ORDER BY created_at_ms, thread_id`() catch (cause) => throw storeError("could not list memory threads")(cause)
    return Effect.forEach(rows, decodeThread)
  }

  const deleteThread: Service["deleteThread"] = (input) => {
    validateNonEmpty(input.threadId, "threadId", ["threadId"])
    return database.write(() => {
      sql`DELETE FROM memory_messages WHERE thread_id = ${input.threadId}`()
      const result = sql`DELETE FROM memory_threads WHERE thread_id = ${input.threadId}`.raw()
      return changed(result) > 0
    }) catch (cause) => throw storeError("could not delete memory thread")(cause)
  }

  const appendMessage: Service["appendMessage"] = (input) => {
    validateNonEmpty(input.threadId, "threadId", ["threadId"])
    validateNonEmpty(input.id, "message id", ["id"])
    validateNonEmpty(input.role, "message role", ["role"])
    validateTime(input.at, "message at", ["at"])
    try {
      database.write(() => {
        sql`INSERT INTO memory_threads (
          thread_id, namespace_kind, namespace_id, created_at_ms, updated_at_ms
        )
          VALUES (${input.threadId}, 'global', 'history', ${input.at}, ${input.at})
          ON CONFLICT (thread_id) DO NOTHING`()
        const inserted = sql`INSERT INTO memory_messages (id, thread_id, role, text, at_ms)
          VALUES (${input.id}, ${input.threadId}, ${input.role}, ${input.text}, ${input.at})
          ON CONFLICT (thread_id, id) DO NOTHING`.raw()
        if (changed(inserted) > 0) {
          sql`UPDATE memory_threads
            SET updated_at_ms = ${Dialect.greatest(sql)}(updated_at_ms, ${input.at})
            WHERE thread_id = ${input.threadId}`()
          return
        }
        const existing = sql<MessageRow>`SELECT ${messageColumns}
          FROM memory_messages
          WHERE thread_id = ${input.threadId} AND id = ${input.id}
          LIMIT 1`()
        const message = existing[0]
        if (message === undefined) {
          throw error("store", "existing memory message could not be read back")
        }
        const conflict = message.role !== input.role
          ? "role"
          : message.text !== input.text
          ? "text"
          : Number(message.at_ms) !== input.at
          ? "at"
          : undefined
        if (conflict !== undefined) {
          throw error(
            "idempotency_conflict",
            `message id "${input.id}" already exists in thread "${input.threadId}" with different ${conflict}`,
            undefined,
            [conflict]
          )
        }
      })
    } catch (cause) {
      throw storeError("could not append memory message")(cause)
    }
  }

  const listMessages: Service["listMessages"] = (input) => {
    validateNonEmpty(input.threadId, "threadId", ["threadId"])
    const limit = validateLimit(input.limit, "listMessages")
    if (limit === 0) return []
    const conditions: Array<Fragment> = [sql`thread_id = ${input.threadId}`]
    if (input.cursor !== undefined) {
      validateTime(input.cursor.at, "message cursor at", ["cursor", "at"])
      validateNonEmpty(input.cursor.id, "message cursor id", ["cursor", "id"])
      conditions.push(
        sql`(at_ms > ${input.cursor.at} OR (at_ms = ${input.cursor.at} AND id > ${input.cursor.id}))`
      )
    }
    const bound = limit === undefined ? sql.literal("") : sql`LIMIT ${limit}`
    const rows = sql<MessageRow>`SELECT ${messageColumns}
      FROM memory_messages
      WHERE ${sql.and(conditions)}
      ORDER BY at_ms, id
      ${bound}`() catch (cause) => throw storeError("could not list memory messages")(cause)
    return rows.map((row) => ({
      threadId: row.thread_id,
      id: row.id,
      role: row.role,
      text: row.text,
      at: Number(row.at_ms)
    }))
  }

  const countMessages: Service["countMessages"] = (input) => {
    validateNonEmpty(input.threadId, "threadId", ["threadId"])
    const rows = sql<{ readonly count: number }>`
      SELECT count(*) AS count FROM memory_messages WHERE thread_id = ${input.threadId}
    `() catch (cause) => throw storeError("could not count memory messages")(cause)
    return Number(rows[0]?.count ?? 0)
  }

  const messageStats: Service["messageStats"] = (input) => {
    validateNonEmpty(input.threadId, "threadId", ["threadId"])
    const rows = sql<{ readonly count: number; readonly code_points: number; readonly bytes: number }>`
      SELECT count(*) AS count,
        COALESCE(SUM(length(text)), 0) AS code_points,
        COALESCE(SUM(${
      sql.literal(Dialect.isPostgres(sql) ? "octet_length(text)" : "length(CAST(text AS BLOB))")
    }), 0) AS bytes
      FROM memory_messages WHERE thread_id = ${input.threadId}
    `() catch (cause) => throw storeError("could not measure memory messages")(cause)
    return {
      messages: Number(rows[0]?.count ?? 0),
      codePoints: Number(rows[0]?.code_points ?? 0),
      bytes: Number(rows[0]?.bytes ?? 0)
    }
  }

  function deleteMessageRows(threadId: string, ids: ReadonlyArray<string>) {
    let deleted = 0
    for (let offset = 0; offset < ids.length; offset += DELETE_MESSAGES_CHUNK_SIZE) {
      const chunk = ids.slice(offset, offset + DELETE_MESSAGES_CHUNK_SIZE)
      const result = sql`DELETE FROM memory_messages
        WHERE thread_id = ${threadId} AND ${sql.in("id", chunk)}`.raw()
      deleted += changed(result)
    }
    return deleted
  }

  const listThreadIds: Service["listThreadIds"] = () => {
    const rows = sql<{ readonly thread_id: string }>`
      SELECT thread_id FROM memory_threads ORDER BY created_at_ms, thread_id
    `() catch (cause) => throw storeError("could not list memory threads")(cause)
    return rows.map((row) => row.thread_id)
  }

  const deleteMessages: Service["deleteMessages"] = (input) => {
    validateNonEmpty(input.threadId, "threadId", ["threadId"])
    const ids = Array.from(new Set(input.ids))
    if (ids.length === 0) {
      return 0
    }
    return database.write(deleteMessageRows(input.threadId, ids)) catch (cause) =>
      throw storeError("could not delete memory messages")(cause)
  }

  const compactMessages = (input: CompactMessagesInput) => {
    // Capture scalar payloads now so caller mutation cannot change a suspended write.
    const threadId = input.threadId
    const summary = { ...input.summary }
    const sources = input.sourceMessages.map((message) => ({ ...message }))
    const compaction: Effect.Effect<number, MemoryError, never> = () => {
      validateNonEmpty(threadId, "threadId", ["threadId"])
      validateNonEmpty(summary.id, "summary id", ["summary", "id"])
      validateNonEmpty(summary.role, "summary role", ["summary", "role"])
      validateTime(summary.at, "summary at", ["summary", "at"])
      if (summary.threadId !== threadId) {
        throw error(
          "invalid_argument",
          "summary threadId must match the compacted thread",
          undefined,
          ["summary", "threadId"]
        )
      }
      if (sources.some((message) => message.threadId !== threadId)) {
        throw error("invalid_argument", "source threadId must match the compacted thread", undefined, ["sourceMessages"])
      }
      const ids = Array.from(new Set(sources.map((message) => message.id))).filter((id) => id !== summary.id)
      if (ids.length === 0) {
        return 0
      }
      return database.write(() => {
        // Preserve the existing-summary error even on a retry whose sources are gone.
        const existing = sql<MessageRow>`SELECT ${messageColumns}
          FROM memory_messages WHERE thread_id = ${threadId} AND id = ${summary.id}`()
        if (existing.length > 0) {
          throw error(
            "idempotency_conflict",
            `summary id "${summary.id}" already exists`,
            undefined,
            ["summary", "id"]
          )
        }
        for (let offset = 0; offset < sources.length; offset += DELETE_MESSAGES_CHUNK_SIZE) {
          const chunk = sources.slice(offset, offset + DELETE_MESSAGES_CHUNK_SIZE)
          const rows = sql<MessageRow>`SELECT ${messageColumns}
            FROM memory_messages WHERE thread_id = ${threadId} AND ${
            sql.in("id", chunk.map((message) => message.id))
          }`()
          const byId = new Map(rows.map((row) => [row.id, row]))
          for (const source of chunk) {
            const row = byId.get(source.id)
            if (
              row === undefined || row.role !== source.role || row.text !== source.text ||
              Number(row.at_ms) !== source.at
            ) {
              throw error(
                "compaction_conflict",
                `source message "${source.id}" changed or disappeared before compaction`,
                undefined,
                ["sourceMessages"]
              )
            }
          }
        }
        sql`INSERT INTO memory_messages (id, thread_id, role, text, at_ms)
          VALUES (${summary.id}, ${summary.threadId}, ${summary.role}, ${summary.text}, ${summary.at})`()
        return deleteMessageRows(threadId, ids)
      }) catch (cause) => throw storeError("could not compact memory history")(cause)
    }
    return compaction
  }

  return {
    createThread,
    getThread,
    listThreads,
    deleteThread,
    appendMessage,
    listMessages,
    countMessages,
    messageStats,
    listThreadIds,
    deleteMessages,
    compactMessages
  }
}
