/**
 * Agent-facing projection of executable, model-visible module routes.
 *
 * @since 0.1.0
 */

import type * as Flow from "@smthrs/core/Flow"
import * as Effect from "effect/Effect"
import * as Option from "effect/Option"
import * as Schema from "effect/Schema"
import * as CommandTree from "./CommandTree.vibe"
import * as FlowInvoker from "./FlowInvoker.vibe"
import { FsError } from "./FsError.vibe"
import * as Boundary from "./internal/Boundary.ts"
import * as CommandLine from "./internal/CommandLine.vibe"
import * as SchemaBridge from "./internal/SchemaBridge.vibe"
import * as Route from "./Route.vibe"

/**
 * A route advertised to an agent.
 *
 * @category models
 * @since 0.1.0
 */
export interface ListedCommand {
  readonly name: string
  readonly description: string | undefined
}

/**
 * A decoded command-string invocation.
 *
 * @category models
 * @since 0.1.0
 */
export interface ParsedCommand<A = unknown> {
  readonly route: Route.Route
  readonly argv: ReadonlyArray<string>
  readonly input: A
}

/**
 * Runtime projection of a route manifest for agent use.
 *
 * @category models
 * @since 0.1.0
 */
export interface CommandSurface {
  /** Lists executable model-visible module routes without loading them. */
  readonly list: () => ReadonlyArray<ListedCommand>
  /** Loads the selected module and schema-decodes an agent command string. */
  readonly parse: (commandString: string) => Effect.Effect<ParsedCommand, FsError>
  /** Parses, invokes, and output-encodes an agent command string. */
  readonly execute: (commandString: string) => Effect.Effect<unknown, FsError, FlowInvoker.FlowInvoker>
  /** Validates decoded input and output for an exact named route. */
  readonly call: <N extends Route.Name>(
    name: N,
    input: Route.Input<N>
  ) => Effect.Effect<Route.Output<N>, FsError, FlowInvoker.FlowInvoker>
}

interface Prepared {
  readonly route: Route.Route
  readonly flow: Pick<Flow.Any, "name" | "input" | "output"> & Partial<Pick<Flow.Any, "description">>
  readonly argv: ReadonlyArray<string>
  readonly input: unknown
}

// Admit and detach even when the typed value contains native Date leaves.
function snapshotDecoded(value: unknown): unknown!FsError {
  const admitted = Boundary.admitDecoded(value)
  if (!admitted.ok) {
    throw new FsError({
      code: "decode_failed",
      method: "Command.call",
      description: "The decoded flow value did not satisfy the boundary"
    })
  }
  return admitted.value
}

function validateDecoded(
  schema: Schema.Top,
  value: unknown,
  field: "input" | "output"
): unknown!FsError {
  const outcome = exit(Schema.decodeUnknownEffect(Schema.toType(schema))(snapshotDecoded(value)))
  if (outcome is Exit.Failure) {
    throw new FsError({
      code: "decode_failed",
      method: "Command.call",
      description: `The decoded flow ${field} did not satisfy its schema`
    })
  }
  return snapshotDecoded(outcome.value)
}

const descriptionOf = (route: Route.Route): string | undefined => Option.getOrUndefined(route.description)

const routeArgv = (argv: ReadonlyArray<string>): ReadonlyArray<string> => {
  const first = argv[0]
  if (first === undefined || !first.includes("/")) return argv
  return Object.freeze([...first.split("/"), ...argv.slice(1)])
}

/**
 * Constructs a command surface from routes.
 *
 * Non-module, hidden, and non-model-invocable routes remain available from the
 * registry but never enter this executable projection.
 *
 * @category constructors
 * @since 0.1.0
 */
export const make = (routes: ReadonlyArray<Route.Route>): CommandSurface!FsError => {
  const validated = CommandTree.make(routes)
  const commandRoutes = CommandTree.traverse(validated).filter(Route.isCommandRoute)
  const tree = CommandTree.make(commandRoutes)

  function prepare(commandString: string): Prepared!FsError {
    const argv = CommandLine.lex(commandString)
    const resolved = CommandTree.resolve(tree, routeArgv(argv))
    const flow = Route.load(resolved.route)
    const schema = SchemaBridge.toCommandSchema(resolved.route.input, flow.input)
    const parsed = CommandLine.parseFlags(resolved.rest)
    const input = schema.decode(schema.assemble(parsed.args, parsed.options))
    return Object.freeze({ route: resolved.route, flow, argv, input })
  }

  function invoke(
    route: Route.Route,
    flow: Pick<Flow.Any, "name" | "input" | "output"> & Partial<Pick<Flow.Any, "description">>,
    input: unknown
  ): unknown!FsError!FlowInvoker.FlowInvoker {
    const invoker = FlowInvoker.FlowInvoker()
    return invoker.invoke(Object.freeze({ name: route.name, flow, input }))
  }

  const listed = Object.freeze(
    CommandTree.traverse(tree).map((route) =>
      Object.freeze({
        name: route.name,
        description: descriptionOf(route)
      })
    )
  )

  const call: CommandSurface["call"] = <N extends Route.Name>(
    name: N,
    candidate: Route.Input<N>
  ): Route.Output<N>!FsError!FlowInvoker.FlowInvoker => withSpan("Command.call") {
    const input = snapshotDecoded(candidate)
    const segments = typeof name === "string" ? name.split("/") : []
    const route = CommandTree.resolveExact(tree, segments)
    const flow = Route.load(route)
    const decoded = validateDecoded(flow.input, input, "input")
    const output = invoke(route, flow, decoded)
    return validateDecoded(flow.output, output, "output") as Route.Output<N>
  }

  return Object.freeze({
    list: () => listed,
    parse: (commandString: string): ParsedCommand!FsError => {
      const { argv, input, route } = prepare(commandString)
      return Object.freeze({ route, argv, input })
    },
    execute: (commandString: string): unknown!FsError!FlowInvoker.FlowInvoker => withSpan("Command.execute") {
      const { flow, input, route } = prepare(commandString)
      const output = invoke(route, flow, input)
      return SchemaBridge.encodeOutput(flow.output, output)
    },
    call
  })
}
