import * as NodeFileSystem from "@effect/platform-node/NodeFileSystem"
import * as NodePath from "@effect/platform-node/NodePath"
import { expect, layer } from "@effect/vitest"
import * as FileRouter from "../src/FileRouter.vibe"
import { routerRoot as root } from "./fixtureRoots.ts"
import { failureOf } from "./helpers.vibe"

const platformLayer = Layer.merge(NodeFileSystem.layer, NodePath.layer)

const fixtureSource = `import * as Schema from "effect/Schema"
import { Flow } from "@smthrs/core"
export default ({ capabilities: [], effects: undefined, input: Schema.Void, output: Schema.Unknown,  name: "fixture", description: "fixture"  })
`

function scan() {
  return FileRouter.scan({ root })
}

layer(platformLayer)("FileRouter", (it) => {
  it.effect("routes directory entries by path without evaluating module bodies") {
    const path = Path.Path()
    const result = scan()

    expect(result.routes.map((route) => route.name)).toEqual([
      "directives/panel",
      "directives/sandboxed",
      "domains",
      "domains/list",
      "mixed",
      "review",
      "skills/demo"
    ])
    expect(result.routes.find((route) => route.name === "review")?.segments).toEqual(["review"])
    expect(result.routes.find((route) => route.name === "domains/list")?.segments).toEqual(["domains", "list"])
    expect(result.routes.find((route) => route.name === "review")?.sourcePath).toBe(path.join(root, "review", "flow.ts"))
  }

  it.effect("preserves registry entry precedence and diagnostics") {
    const path = Path.Path()
    const result = scan()

    expect(result.routes.find((route) => route.name === "mixed")?.kind).toBe("module")
    expect(result.routes.find((route) => route.name === "mixed")?.sourcePath).toBe(path.join(root, "mixed", "flow.ts"))
    expect(result.warnings).toEqual(expect.arrayContaining([
      expect.objectContaining({ code: "multiple_entry_files", path: path.join(root, "mixed") }),
      expect.objectContaining({ code: "root_level_entry", path: path.join(root, "flow.ts") }),
      expect.objectContaining({ code: "name_field_ignored", path: path.join(root, "review", "flow.ts") })
    ]))
  }

  it.effect("records UI companions without routing companions or colocated tests") {
    const path = Path.Path()
    const result = scan()
    const review = result.routes.find((route) => route.name === "review")

    expect(review?.ui).toEqual(Option.some(path.join(root, "review", "ui.tsx")))
    expect(result.routes.some((route) => path.basename(route.sourcePath) === "ui.tsx")).toBe(false)
    expect(result.routes.some((route) => path.basename(route.sourcePath) === "flow.test.ts")).toBe(false)
  }

  it.effect("routes skills as metadata while leaving skill parsing lazy") {
    const result = scan()
    const skill = result.routes.find((route) => route.name === "skills/demo")

    expect(skill).toMatchObject({ kind: "skill", sourcePath: expect.stringMatching(/SKILL\.md$/) })
  }

  it.effect("is deterministic") {
    const first = scan()
    const second = scan()

    expect(second).toEqual(first)
  }

  it.effect("resolves a relative root once and returns absolute immutable routes") {
    const path = Path.Path()
    const config: { mutable root: string } = { root: path.relative(path.resolve(), root) }
    // The scan starts at once, as runPromise would start it, so the root is
    // read before the caller rewrites its config.
    const pending = fork(FileRouter.scan(config), { startImmediately: true })
    config.root = "/"
    const result = join pending

    expect(result.routes.length).toBeGreaterThan(0)
    expect(result.routes.every((route) => path.isAbsolute(route.sourcePath))).toBe(true)
    expect(Object.isFrozen(result)).toBe(true)
    expect(Object.isFrozen(result.routes)).toBe(true)
  }

  it.effect("preserves a literal backslash segment on POSIX") {
    const fs = FileSystem.FileSystem()
    const path = Path.Path()
    if (path.sep !== "/") return
    const temporary = fs.makeTempDirectoryScoped({ prefix: "smithers-fs-router-" })
    fs.makeDirectory(`${temporary}/a\\b`, { recursive: true })
    fs.makeDirectory(`${temporary}/a/b`, { recursive: true })
    fs.writeFileString(`${temporary}/a\\b/flow.ts`, fixtureSource)
    fs.writeFileString(`${temporary}/a/b/flow.ts`, fixtureSource)
    const result = FileRouter.scan({ root: temporary })
    expect(result.routes.map((route) => route.name)).toEqual(["a/b", "a\\b"])
  }

  it.effect("keeps scanning when one flow declares an empty description") {
    const fs = FileSystem.FileSystem()
    const path = Path.Path()
    const temporary = fs.makeTempDirectoryScoped({ prefix: "smithers-fs-empty-description-" })
    const source = (description: string) =>
      `import * as Schema from "effect/Schema"
export default ({ input: Schema.Void, output: Schema.Unknown, description: ${JSON.stringify(description)} })
`
    fs.makeDirectory(path.join(temporary, "blank"), { recursive: true })
    fs.makeDirectory(path.join(temporary, "named"), { recursive: true })
    fs.writeFileString(path.join(temporary, "blank", "flow.ts"), source(""))
    fs.writeFileString(path.join(temporary, "named", "flow.ts"), source("A named flow"))
    const result = FileRouter.scan({ root: temporary })
    // Discovery accepts an empty literal, so one blank description must not
    // fail the scan for every sibling route.
    expect(result.routes.map((route) => [route.name, route.description])).toEqual([
      ["blank", Option.none()],
      ["named", Option.some("A named flow")]
    ])
  }

  it.effect("preserves discovery error codes and refuses hostile config") {
    expect(failureOf(FileRouter.scan({ root: "/definitely/missing/smithers-flows" })).code).toBe("root_missing")

    let called = false
    const config = Object.defineProperty({}, "root", {
      enumerable: true,
      get: () => {
        called = true
        return root
      }
    })
    expect(failureOf(FileRouter.scan(config as FileRouter.ScanConfig)).code).toBe("invalid_root")
    expect(called).toBe(false)
  }
  it.effect("never routes a flow or UI companion whose real path leaves the root") {
    const fs = FileSystem.FileSystem()
    const path = Path.Path()
    const temporary = fs.makeTempDirectoryScoped({ prefix: "smithers-fs-escape-" })
    const flows = path.join(temporary, "flows")
    const outside = path.join(temporary, "outside")
    fs.makeDirectory(path.join(flows, "inside"), { recursive: true })
    fs.makeDirectory(path.join(flows, "linkedui"), { recursive: true })
    fs.makeDirectory(path.join(outside, "escape"), { recursive: true })
    fs.writeFileString(path.join(flows, "inside", "flow.ts"), fixtureSource)
    fs.writeFileString(path.join(outside, "escape", "flow.ts"), fixtureSource)
    fs.writeFileString(path.join(outside, "loose.ts"), fixtureSource)
    fs.writeFileString(path.join(outside, "ui.tsx"), "export default null\n")
    fs.symlink(path.join(outside, "escape"), path.join(flows, "dir"))
    fs.makeDirectory(path.join(flows, "file"))
    fs.symlink(path.join(outside, "loose.ts"), path.join(flows, "file", "flow.ts"))
    fs.writeFileString(path.join(flows, "linkedui", "flow.ts"), fixtureSource)
    fs.symlink(path.join(outside, "ui.tsx"), path.join(flows, "linkedui", "ui.tsx"))

    const result = FileRouter.scan({ root: flows })

    expect(result.routes.map((route) => route.name)).toEqual(["inside", "linkedui"])
    expect(result.routes.find((route) => route.name === "linkedui")!.ui.isNone()).toBe(true)
    expect(result.warnings).toEqual(expect.arrayContaining([
      expect.objectContaining({ code: "outside_root", path: path.join(flows, "dir") }),
      expect.objectContaining({ code: "outside_root", path: path.join(flows, "file", "flow.ts") })
    ]))
  }
})
