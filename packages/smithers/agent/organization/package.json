{
  "name": "@smthrs/organization",
  "type": "module",
  "version": "1.0.0-rc.1",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "description": "Durable agent organizations on Smithers: role profiles, grants, composed prompts, hiring, configurable gates, meetings, and a local host",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/agent/organization"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "flow",
    "agents",
    "organization"
  ],
  "keywords": [
    "typescript",
    "effect",
    "flow",
    "agents",
    "organization"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./migrations/*": null,
    "./*/index": null,
    "./Grants": "./src/Grants.ts",
    "./Hiring": "./src/Hiring.ts",
    "./Meetings": "./src/Meetings.ts",
    "./Profile": "./src/Profile.ts",
    "./Prompt": "./src/Prompt.ts",
    "./Roster": "./src/Roster.ts",
    "./Skills": "./src/Skills.ts",
    "./index": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./internal/*": null,
      "./migrations/*": null,
      "./*/index": null,
      "./Grants": {
        "import": {
          "types": "./dist/esm/Grants.d.ts",
          "default": "./dist/esm/Grants.js"
        },
        "require": {
          "types": "./dist/cjs/Grants.d.ts",
          "default": "./dist/cjs/Grants.js"
        }
      },
      "./Hiring": {
        "import": {
          "types": "./dist/esm/Hiring.d.ts",
          "default": "./dist/esm/Hiring.js"
        },
        "require": {
          "types": "./dist/cjs/Hiring.d.ts",
          "default": "./dist/cjs/Hiring.js"
        }
      },
      "./Meetings": {
        "import": {
          "types": "./dist/esm/Meetings.d.ts",
          "default": "./dist/esm/Meetings.js"
        },
        "require": {
          "types": "./dist/cjs/Meetings.d.ts",
          "default": "./dist/cjs/Meetings.js"
        }
      },
      "./Profile": {
        "import": {
          "types": "./dist/esm/Profile.d.ts",
          "default": "./dist/esm/Profile.js"
        },
        "require": {
          "types": "./dist/cjs/Profile.d.ts",
          "default": "./dist/cjs/Profile.js"
        }
      },
      "./Prompt": {
        "import": {
          "types": "./dist/esm/Prompt.d.ts",
          "default": "./dist/esm/Prompt.js"
        },
        "require": {
          "types": "./dist/cjs/Prompt.d.ts",
          "default": "./dist/cjs/Prompt.js"
        }
      },
      "./Roster": {
        "import": {
          "types": "./dist/esm/Roster.d.ts",
          "default": "./dist/esm/Roster.js"
        },
        "require": {
          "types": "./dist/cjs/Roster.d.ts",
          "default": "./dist/cjs/Roster.js"
        }
      },
      "./Skills": {
        "import": {
          "types": "./dist/esm/Skills.d.ts",
          "default": "./dist/esm/Skills.js"
        },
        "require": {
          "types": "./dist/cjs/Skills.d.ts",
          "default": "./dist/cjs/Skills.js"
        }
      },
      "./index": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/agent": "1.0.0-rc.1",
    "@smthrs/control": "1.0.0-rc.1",
    "@smthrs/database": "1.0.0-rc.1",
    "@smthrs/flow": "1.0.0-rc.1",
    "@smthrs/plan": "1.0.0-rc.1",
    "@smthrs/integrations": "1.0.0-rc.1",
    "@smthrs/memory": "1.0.0-rc.1",
    "@smthrs/canonical": "1.0.0-rc.1",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "4.0.0-rc.115",
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.115",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0",
    "@effect/platform-node": "4.0.0-rc.115"
  }
}
