/**
 * Migration statement diagnostics.
 *
 * @since 0.1.0
 */

import * as Effect from "effect/Effect"
import { error, type TimeTravelError } from "../TimeTravelError.vibe"

/**
 * Names the SQL object while retaining the driver failure.
 *
 * @since 0.1.0
 * @private
 */
export function step<A, E, R>(object: string, statement: Effect.Effect<A, E, R>): A!TimeTravelError!R {
  try { return statement() } catch (cause) { throw error("unknown", `time-travel migration failed creating ${object}`, cause) }
}
