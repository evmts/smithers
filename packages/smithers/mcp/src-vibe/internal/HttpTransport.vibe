/**
 * JSON-RPC over the MCP Streamable HTTP transport.
 *
 * Every client message is one `POST` to the server's endpoint. A notification
 * is answered with `202 Accepted`; a request is answered either with one
 * `application/json` reply or with a `text/event-stream` whose events carry
 * server notifications, server requests, and finally the reply. The server's
 * `Mcp-Session-Id` from `initialize` is sent on every later message, together
 * with the negotiated `MCP-Protocol-Version`.
 *
 * Requests go through the `HttpClient` in context, which is the host's egress
 * client: its proxy, pinning, and capability checks apply unchanged, and a
 * destination the egress policy denies fails with `connection_closed`.
 *
 * Out of scope: the optional standalone `GET` event stream, resuming a broken
 * event stream with `Last-Event-ID`, and OAuth discovery. An expired session
 * fails rather than re-initializing, so no request is ever replayed.
 *
 * @since 1.0.0-rc.1
 */

import { isRecord } from "@smthrs/canonical/Record"
import * as KernelHttpClient from "@smthrs/kernel/HttpClient"
import { Cause, Deferred, Effect, Exit, Option, type Redacted, type Scope, Stream, Tracer } from "effect"
import * as Headers from "effect/http/Headers"
import * as HttpClient from "effect/http/HttpClient"
import type * as HttpClientError from "effect/http/HttpClientError"
import * as HttpClientRequest from "effect/http/HttpClientRequest"
import type { McpError } from "../McpError.vibe"
import * as DiagnosticReporter from "./DiagnosticReporter.vibe"
import * as JsonLimits from "./JsonLimits.vibe"
import * as Limits from "./Limits.vibe"
import * as Rpc from "./Rpc.ts"
import * as Transport from "./Transport.vibe"

/**
 * Supplies the bearer credential for a Streamable HTTP server.
 *
 * `token` runs once per HTTP message, so a provider can rotate or refresh the
 * credential between messages. Its failure fails that message unchanged.
 *
 * @category models
 * @since 1.0.0-rc.1
 */
export interface AuthProvider {
  readonly token: Effect.Effect<Redacted.Redacted<string>, McpError>
}

/**
 * Options accepted by {@link connect}.
 *
 * @category models
 * @since 1.0.0-rc.1
 */
export interface ConnectOptions {
  /** The name this server is known by, for error messages only. */
  readonly server: string
  /** The server's MCP endpoint: an absolute `http:` or `https:` URL without credentials. */
  readonly url: string
  /** Bearer credential source. Omit for a server that needs none. */
  readonly authProvider?: AuthProvider | undefined
  /** Default deadline for a request/reply exchange. See {@link Transport.defaultRequestTimeoutMs}. */
  readonly requestTimeoutMs?: number | undefined
  /** Maximum UTF-8 bytes accepted in one inbound JSON-RPC message. See {@link Transport.defaultMaxFrameBytes}. */
  readonly maxFrameBytes?: number | undefined
  /** Maximum UTF-8 bytes emitted in one JSON-RPC message. See {@link Transport.defaultMaxOutboundFrameBytes}. */
  readonly maxOutboundFrameBytes?: number | undefined
}

/** Deadline for the best-effort `DELETE` that ends a session on scope close. */
const sessionCloseMs = 1_000

/** A session id is visible ASCII only (0x21-0x7E). */
const validSessionId = /^[\x21-\x7e]+$/

const endpointOf = (url: string): URL | undefined => {
  if (!URL.canParse(url)) return undefined
  const parsed = new URL(url)
  if (parsed.protocol !== "http:" && parsed.protocol !== "https:") return undefined
  if (parsed.username !== "" || parsed.password !== "") return undefined
  return parsed
}

/**
 * Header names a host that records HTTP headers on spans must not see in
 * clear: the session id every later message is authorized by, and the headers
 * of a redirect, which name the endpoint under another address.
 */
const redactedHeaderNames: ReadonlyArray<string> = ["mcp-session-id", "location", "content-location"]

/**
 * The span attributes of an exchange that say nothing of the url's path or
 * query: the method, the origin and the answer.
 */
const originAttributes: ReadonlySet<string> = new Set([
  "http.request.method",
  "url.scheme",
  "server.address",
  "server.port",
  "http.response.status_code",
  "error.type"
])

const isHeaderAttribute = (key: string): boolean =>
  key.startsWith("http.request.header.") || key.startsWith("http.response.header.")

/**
 * The tracer an exchange opens its HTTP span on: the caller's own, with
 * nothing of the request left on the span.
 *
 * An MCP endpoint is often a capability url, with its key in the path or the
 * query. The HTTP client writes the whole url on its span and again in the
 * failure it ends the span with, and the answer or the transport error it ends
 * with holds the request. So only the attributes that name the method, the
 * origin and the answer are kept, with the headers a host chose to record, and
 * the span ends with the outcome alone: nothing on success, the refusing
 * status, or that the server could not be reached.
 */
const withoutRequest = (server: string) => (tracer: Tracer.Tracer): Tracer.Tracer =>
  Tracer.make({
    ...tracer,
    span(options) {
      const span = tracer.span(options)
      const end = span.end.bind(span)
      const attribute = span.attribute.bind(span)
      span.attribute = (key, value) => {
        if (originAttributes.has(key) || isHeaderAttribute(key)) attribute(key, value)
      }
      span.end = (endTime, exit) => {
        if (exit._tag === "Success") return end(endTime, Exit.void)
        if (Cause.hasInterruptsOnly(exit.cause)) return end(endTime, exit)
        const status = span.attributes.get("http.response.status_code")
        return end(
          endTime,
          Exit.fail(
            typeof status === "number"
              ? Limits.protocolError(server, `MCP server "${server}" answered with HTTP ${status}`)
              : Transport.closed(server, "is not reachable; transport details withheld")
          )
        )
      }
      return span
    }
  })

const utf8 = new TextEncoder()

/** Whether the HTTP message for a request has been handed to the client. */
type Dispatched = { mutable value: boolean }

/** A whole response body, accumulated chunk by chunk. */
type BodyAccumulator = { mutable chunks: Array<Uint8Array>; mutable bytes: number }

/** One server-sent event's `data:` lines, accumulated until a blank line. */
type EventAccumulator = { mutable data: string | undefined; mutable bytes: number }

const mediaType = (header: string | undefined): string => (header ?? "").split(";")[0]!.trim().toLowerCase()

/**
 * Opens a Streamable HTTP session and returns a live {@link Transport.Transport}.
 * No message is sent until the first request; the endpoint and limits are
 * checked first. Closing the calling scope ends the session with a
 * best-effort `DELETE` and rejects later traffic.
 *
 * @category constructors
 * @since 1.0.0-rc.1
 */
export const connect = (
  options: ConnectOptions
): Effect.Effect<Transport.Transport, McpError, HttpClient.HttpClient | Scope.Scope> => {
  const server = options.server
  const diagnostic = DiagnosticReporter.make(server)
  const requestTimeoutMs = options.requestTimeoutMs ?? Transport.defaultRequestTimeoutMs
  const maxFrameBytes = options.maxFrameBytes ?? Transport.defaultMaxFrameBytes
  const maxOutboundFrameBytes = options.maxOutboundFrameBytes ?? Transport.defaultMaxOutboundFrameBytes
  Limits.checkPositiveIntegers(server, [
    ["requestTimeoutMs", requestTimeoutMs],
    ["maxFrameBytes", maxFrameBytes],
    ["maxOutboundFrameBytes", maxOutboundFrameBytes]
  ])
  const endpoint = endpointOf(options.url)
  if (endpoint === undefined) {
    throw Limits.protocolError(
      server,
      `MCP server "${server}" url must be an absolute http or https URL without credentials`
    )
  }
  const url: URL = endpoint
  // Each message runs in its own scope, which aborts the HTTP request and
  // releases its body however the exchange ends.
  const client = HttpClient.withScope(HttpClient.HttpClient())
  /** Sends one HTTP message, keeping the endpoint and the session id out of its span. */
  function send(request: HttpClientRequest.HttpClientRequest) {
    const names = Headers.CurrentRedactedNames()
    const tracer = Tracer.Tracer()
    // A host may name HTTP spans for their url. This one is named for its
    // method, as the client names it by default.
    provide Headers.CurrentRedactedNames = [...names, ...redactedHeaderNames],
      HttpClient.SpanNameGenerator = (sent) => sent.method,
      Tracer.Tracer = withoutRequest(server)(tracer) {
      return client.execute(request)
    }
  }
  const scope = Effect.scope()
  const closing = Deferred.make<void>()

  let open = true
  let sessionId: string | undefined
  let protocolVersion: string | undefined
  let nextId = 0

  const unreachable = (error: HttpClientError.HttpClientError): McpError => {
    diagnostic("transport", error.message)
    return Option.isSome(KernelHttpClient.fromHttpClientError(error))
      ? Transport.closed(server, "is not reachable: egress to its URL is not granted")
      : Transport.closed(server, "is not reachable; transport details withheld")
  }

  function frameOf(method: string, message: Rpc.OutboundMessage): Uint8Array!McpError {
    // Rpc.encode appends the stdio line terminator; an HTTP body has none.
    const frame = Rpc.encode(message).subarray(0, -1)
    if (frame.byteLength <= maxOutboundFrameBytes) return frame
    throw Limits.protocolError(
      server,
      `MCP server "${server}" tried to send a ${method} frame larger than ${maxOutboundFrameBytes} bytes`
    )
  }

  const withSession = (request: HttpClientRequest.HttpClientRequest): HttpClientRequest.HttpClientRequest => {
    let next = request
    if (sessionId !== undefined) next = HttpClientRequest.setHeader(next, "mcp-session-id", sessionId)
    if (protocolVersion !== undefined) {
      next = HttpClientRequest.setHeader(next, "mcp-protocol-version", protocolVersion)
    }
    return next
  }

  /** Reads a whole body, failing once it passes `maxFrameBytes`. */
  function readBody(stream: Stream.Stream<Uint8Array, HttpClientError.HttpClientError>): string!McpError {
    const body = Stream.runFoldEffect(
      Stream.mapError(stream, unreachable),
      (): BodyAccumulator => ({ chunks: [], bytes: 0 }),
      (body, chunk) => {
        body.bytes += chunk.byteLength
        if (body.bytes > maxFrameBytes) {
          throw Limits.protocolError(server, `MCP frame exceeded ${maxFrameBytes} bytes`)
        }
        body.chunks.push(chunk)
        return body
      }
    )
    const joined = new Uint8Array(body.bytes)
    let offset = 0
    for (const chunk of body.chunks) {
      joined.set(chunk, offset)
      offset += chunk.byteLength
    }
    return new TextDecoder().decode(joined)
  }

  function authorize(request: HttpClientRequest.HttpClientRequest): HttpClientRequest.HttpClientRequest!McpError {
    if (options.authProvider === undefined) return request
    const token = options.authProvider.token()
    return HttpClientRequest.bearerToken(request, token)
  }

  /**
   * Sends one message and returns the raw response, or fails with a
   * transport, status, or session failure.
   */
  function post(method: string, message: Rpc.OutboundMessage, dispatched?: Dispatched) {
    if (!open) throw Transport.closed(server, "connection scope closed")
    const body = frameOf(method, message)
    const request = authorize(withSession(
      HttpClientRequest.post(url).pipe(
        HttpClientRequest.setHeader("accept", "application/json, text/event-stream"),
        HttpClientRequest.bodyUint8Array(body, "application/json")
      )
    ))
    const sentSession = sessionId !== undefined
    if (dispatched !== undefined) dispatched.value = true
    const response = send(request) catch (error) => throw unreachable(error)
    if (response.status === 404 && sentSession) {
      throw Transport.closed(server, "ended the session; reconnect to continue")
    }
    if (response.status < 200 || response.status > 299) {
      diagnostic("remote-error", { status: response.status })
      throw Limits.protocolError(
        server,
        `MCP server "${server}" answered ${method} with HTTP ${response.status}`
      )
    }
    return response
  }

  /** Sends a notification or a reply to a server request; the body is ignored. */
  function deliver(method: string, message: Rpc.OutboundMessage): void!McpError {
    Effect.scoped(() => {
      const response = post(method, message)
      readBody(response.stream)
    })
  }

  /** Fails `effect` with `connection_closed`, interrupting it, when the scope closes first. */
  function untilClosed<A>(effect: Effect.Effect<A, McpError, never>): A!McpError {
    return await.race [
      effect(),
      do {
        closing.await()
        throw Transport.closed(server, "connection scope closed")
      }
    ]
  }

  /**
   * Handles one inbound JSON-RPC message during request `id`: server
   * requests are answered, notifications dropped, and the reply returned.
   */
  function receive(method: string, id: number, text: string): Option.Option<unknown>!McpError {
    const message = Rpc.parse(text)
    if (message === undefined) {
      throw Limits.protocolError(server, `MCP server "${server}" sent a message that is not JSON-RPC`)
    }
    const jsonIssue = JsonLimits.checkParsed(message)
    if (jsonIssue !== undefined) {
      throw Limits.protocolError(server, `MCP server "${server}" sent invalid JSON: ${jsonIssue}`)
    }
    const reply = Rpc.classify(message)
    switch (reply._tag) {
      case "Notification":
        return Option.none()
      case "Request": {
        deliver(
          "server-response",
          reply.method === "ping"
            ? { jsonrpc: "2.0", id: reply.id, result: {} }
            : { jsonrpc: "2.0", id: reply.id, error: { code: -32_601, message: "Method not found" } }
        )
        return Option.none()
      }
      case "Malformed":
        throw Limits.protocolError(
          server,
          `MCP server "${server}" sent a malformed JSON-RPC reply: ${reply.reason}`
        )
      case "UncorrelatedError":
        diagnostic("remote-error", { code: reply.code, message: reply.message, data: reply.data })
        return Option.none()
    }
    if (reply.id !== id) {
      throw Limits.protocolError(
        server,
        `MCP server "${server}" answered ${method} with a reply to another request`
      )
    }
    if (reply._tag === "Error") {
      diagnostic("remote-error", { code: reply.code, message: reply.message, data: reply.data })
      throw Transport.replyError(server, method, reply)
    }
    return Option.some(reply.result)
  }

  /** Collects `data:` lines into events; a blank line ends one. */
  const events = (
    stream: Stream.Stream<Uint8Array, HttpClientError.HttpClientError>
  ): Stream.Stream<string, McpError> =>
    Transport.lines(server, maxFrameBytes, Stream.mapError(stream, unreachable), { crTerminates: true }).pipe(
      Stream.mapAccumEffect(
        (): EventAccumulator => ({ data: undefined, bytes: 0 }),
        (event, line) => {
          if (line === "") {
            const data = event.data
            event.data = undefined
            event.bytes = 0
            // An event with empty data carries no message: a resumable
            // stream opens with one to hand the client its first event id.
            return [event, data === undefined || data === "" ? [] : [data]] as const
          }
          if (!line.startsWith("data:")) return [event, []] as const
          const value = line.slice(line.startsWith("data: ") ? 6 : 5)
          event.bytes += utf8.encode(value).byteLength + (event.data === undefined ? 0 : 1)
          event.data = event.data === undefined ? value : `${event.data}\n${value}`
          if (event.bytes > maxFrameBytes) {
            throw Limits.protocolError(server, `MCP frame exceeded ${maxFrameBytes} bytes`)
          }
          return [event, []] as const
        }
      )
    )

  function exchange(method: string, params: unknown, id: number, dispatched: Dispatched): unknown!McpError {
    return Effect.scoped(() => {
      const response = post(method, { jsonrpc: "2.0", id, method, params }, dispatched)
      if (method === "initialize") {
        const header = response.headers["mcp-session-id"]
        if (header !== undefined && !validSessionId.test(header)) {
          throw Limits.protocolError(server, `MCP server "${server}" sent an invalid session id`)
        }
        sessionId = header
      }
      const type = mediaType(response.headers["content-type"])
      let result: Option.Option<unknown>
      if (type === "application/json") {
        const text = readBody(response.stream)
        result = receive(method, id, text)
      } else if (type === "text/event-stream") {
        result = Option.flatten(
          Stream.runHead(
            events(response.stream).pipe(
              Stream.mapEffect((data) => receive(method, id, data)),
              Stream.filter(Option.isSome)
            )
          )
        )
      } else {
        throw Limits.protocolError(
          server,
          `MCP server "${server}" answered ${method} with an unsupported content type`
        )
      }
      if (Option.isNone(result)) {
        throw Transport.closed(server, `closed its response before answering ${method}`)
      }
      if (method === "initialize" && isRecord(result.value) && typeof result.value.protocolVersion === "string") {
        protocolVersion = result.value.protocolVersion
      }
      return result.value
    })
  }

  const notify = (method: string, params?: unknown, timeoutMs = requestTimeoutMs): Effect.Effect<void, McpError, never> => {
    if (!Limits.isPositiveInteger(timeoutMs)) {
      throw Limits.protocolError(server, "MCP notification timeout must be a positive integer")
    }
    Effect.timeoutOrElse(untilClosed(deliver(method, { jsonrpc: "2.0", method, params })), {
      duration: timeoutMs,
      orElse: () => {
        throw Transport.timeout(server, method, timeoutMs)
      }
    })
  }

  const request = (
    method: string,
    params?: unknown,
    timeoutMs = requestTimeoutMs
  ): Effect.Effect<unknown, McpError, never> => {
    if (!Limits.isPositiveInteger(timeoutMs)) {
      throw Limits.protocolError(server, "MCP request timeout must be a positive integer")
    }
    const id = ++nextId
    const dispatched: Dispatched = { value: false }
    return Effect.timeoutOrElse(
      untilClosed(
        Effect.onInterrupt(
          exchange(method, params, id, dispatched),
          // Closing the HTTP response is not a cancellation in MCP; tell the
          // server explicitly, without delaying the deadline being reported.
          () => {
            if (dispatched.value && open && method !== "initialize") {
              Effect.forkIn(() => {
                Effect.ignore(notify("notifications/cancelled", {
                  requestId: id,
                  reason: Transport.cancellationReason
                }))
              }, scope)
            }
          }
        )
      ),
      {
        duration: timeoutMs,
        orElse: () => {
          throw Transport.timeout(server, method, timeoutMs)
        }
      }
    )
  }

  Effect.addFinalizer(() => {
    open = false
    const session = sessionId
    Deferred.succeed(closing, undefined)
    if (session === undefined) return
    try {
      timeout(() => {
        Effect.scoped(() => {
          const request = authorize(withSession(HttpClientRequest.delete(url)))
          send(request)
        })
      }, sessionCloseMs)
    } catch (_) {
      // Ignored: ending the session is best-effort.
    }
  })

  return { request, notify }
}
