{
	// patterns.smithers.sh: the orchestration-patterns field guide, one static page.
	// Deploy from apps/server, which carries wrangler:
	//   pnpm --dir apps/server exec wrangler deploy -c ../patterns-site/wrangler.jsonc
	"name": "patterns-site",
	"compatibility_date": "2026-07-02",
	"workers_dev": true,
	"assets": { "directory": "site" },
	"routes": [{ "pattern": "patterns.smithers.sh", "custom_domain": true }],
	"observability": { "enabled": true }
}
