      "workspace": "pnpm-workspace.yaml",
      "sharedPaths": [
        ".github/",
        "scripts/",
        "tsconfig*.json",
        "vitest.config.ts",
        "pnpm-lock.yaml",
        "package.json"
      ],
      "changesets": {
        "directory": ".changeset",
        "config": ".changeset/config.json",
        "prerelease": "rc"
      },
      "ci": {
        "workflows": [
          ".github/workflows/check.yml",
          ".github/workflows/release.yml"
        ],
        "projects": "vitest.config.ts"
      },
      "flows": {
        "implement": "implement-issue",
        "release": "release-plan"
      }
    }
