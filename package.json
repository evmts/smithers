{
  "name": "smithers",
  "description": "Smithers maintains your codebase. It turns issues into reviewed, tested changes and, when enabled, keeps the project wiki current. Flows beside your code define how.",
  "author": "William Cory",
  "license": "MIT",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithersai/smithers.git"
  },
  "homepage": "https://github.com/smithersai/smithers#readme",
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "packageManager": "pnpm@11.25.0",
  "workspaces": [
    "packages/*",
    "packages/smithers/*",
    "packages/smithers/agent/*",
    "packages/smithers/build/*",
    "packages/smithers/flows/*",
    "packages/smithers/ui/*",
    "examples",
    "flows",
    "flows/coding",
    "apps/*",
    "evals/*"
  ],
  "scripts": {
    "commit": "node scripts/commit.mjs",
    "deploy": "pnpm --filter smithers-server run deploy",
    "tui": "bun apps/tui/src/main.tsx",
    "release:workflow": "node --experimental-strip-types flows/release-support/main.ts release",
    "release:content": "node --experimental-strip-types flows/release-support/main.ts release-content",
    "release:status": "node --experimental-strip-types flows/release-support/main.ts status",
    "release:answer": "node --experimental-strip-types flows/release-support/main.ts answer",
    "browser": "node scripts/browser-check.mjs",
    "check": "pnpm --recursive --if-present run check",
    "check:npm-dedupe": "node scripts/check-npm-dedupe.mjs",
    "circular": "pnpm --recursive --if-present run circular",
    "dev": "pnpm --filter smithers-app run start",
    "checklist": "pnpm --filter smithers-app run checklist",
    "deploy:dry": "pnpm --filter smithers-server run deploy:dry",
    "docs:check": "go run ./packages/backend/modelprice/cmd/generate -check && node scripts/package-docs.mjs --check && node scripts/package-docs.test.mjs",
    "docs:sync": "pnpm --filter @smithers/site run sync:docs && node scripts/package-docs.mjs --write",
    "lint": "pnpm --recursive --if-present run lint",
    "target-index": "pnpm exec smthrs target '//:targetIndex' --write",
    "test": "pnpm --recursive --if-present run test",
    "test:e2e": "pnpm --filter smithers-app run test:e2e",
    "test:jsdoc": "node --test eslint.jsdoc.test.mjs",
    "test:examples": "pnpm --filter @smthrs/examples run test",
    "lint:jsdoc": "eslint --config eslint.config.js \"packages/*/src/**/*.ts\" \"packages/*/*/src/**/*.ts\" \"packages/*/*/*/src/**/*.ts\" --max-warnings=0"
  },
  "engines": {
    "node": ">=26.4.0",
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-logical-assignment-operators": "^7.29.7",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.29.7",
    "@babel/plugin-transform-optional-chaining": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@effect/platform-node": "4.0.4",
    "@playwright/test": "1.62.1",
    "@smthrs/build-cli": "workspace:*",
    "@smthrs/cli": "workspace:*",
    "@smthrs/database": "workspace:*",
    "@smthrs/engine": "workspace:*",
    "@smthrs/engine-store": "workspace:*",
    "@smthrs/flow": "workspace:*",
    "@smthrs/flows": "workspace:*",
    "@smthrs/journal": "workspace:*",
    "@smthrs/kernel": "workspace:*",
    "@smthrs/plan": "workspace:*",
    "@smthrs/repo-targets": "workspace:*",
    "@smthrs/run-store": "workspace:*",
    "@smthrs/targets": "workspace:*",
    "@smthrs/ui": "workspace:*",
    "@types/node": "26.4.1",
    "effect": "4.0.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsdoc": "64.3.4",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-lib-source-maps": "^5.0.6",
    "istanbul-reports": "^3.2.0",
    "mermaid": "^11.17.2",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "7.8.5",
    "smithers-app": "workspace:*",
    "tinyglobby": "0.2.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "^8.2.2",
    "ws": "8.22.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "effect": "4.0.4",
    "@effect/opentelemetry": "4.0.4",
    "@effect/platform-bun": "4.0.4",
    "@effect/platform-node": "4.0.4",
    "@effect/platform-node-shared": "4.0.4",
    "@effect/sql-d1": "4.0.4",
    "@effect/sql-sqlite-bun": "4.0.4",
    "@effect/sql-sqlite-do": "4.0.4",
    "@effect/sql-sqlite-node": "4.0.4",
    "@effect/vitest": "4.0.4"
  },
  "patchedDependencies": {
    "dprint@0.57.1": "patches/dprint@0.57.1.patch"
  }
}
